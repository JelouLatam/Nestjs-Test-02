# Example environment variables for Jelou NestJS-Test-02

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=todo_db

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=3600s

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (for logging)
MONGO_URI=mongodb://localhost:27017/logs

# Other
NODE_ENV=development
PORT=3000
