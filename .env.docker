# Docker Environment Configuration
# Copy this to .env for local Docker development

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_URL=/app/data/database.sqlite

# Alternative MySQL Configuration (uncomment to use MySQL instead of SQLite)
# DATABASE_TYPE=mysql
# DATABASE_HOST=mysql
# DATABASE_PORT=3306
# DATABASE_USERNAME=todouser
# DATABASE_PASSWORD=todopassword
# DATABASE_NAME=todoapp

# JWT Configuration
JWT_SECRET=docker-development-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=true